@startuml
title Account Routes

actor Client
participant "AccountResource" as Resource
participant "MonetaryContext\n(Facade)" as Facade
participant "AccountUseCase" as UseCase

== GET /api/{uuid}/accounts ==
Client -> Resource: GET /api/{uuid}/accounts?type={type}
activate Resource
alt type is CARD
    Resource -> Facade: listCreditCards()
    activate Facade
    Facade -> UseCase: listCreditCards()
    activate UseCase
    UseCase --> Facade: Result<List<MonetaryAccount>>
    deactivate UseCase
    Facade --> Resource: Result<List<MonetaryAccount>>
    deactivate Facade
else otherwise
    Resource -> Facade: listAccounts()
    activate Facade
    Facade -> UseCase: listAccounts()
    activate UseCase
    UseCase --> Facade: Result<List<MonetaryAccount>>
    deactivate UseCase
    Facade --> Resource: Result<List<MonetaryAccount>>
    deactivate Facade
end
Resource -> Facade: listTransactions()
activate Facade
Facade --> Resource: Result<List<MonetaryTransaction>>
deactivate Facade
Resource --> Client: 200 OK (List<Account>)
deactivate Resource

== GET /api/{uuid}/accounts/{id}/balance ==
Client -> Resource: GET /api/{uuid}/accounts/{id}/balance?period={yyyyMM}&year={yyyy}
activate Resource
alt period provided
    Resource -> Facade: getMonthlyBalance(id, period)
    activate Facade
    Facade -> UseCase: getMonthlyBalance(id, period)
    activate UseCase
    UseCase --> Facade: Result<MonthlyBalance>
    deactivate UseCase
    Facade --> Resource: Result<MonthlyBalance>
    deactivate Facade
    Resource --> Client: 200 OK (MonthlyBalance)
else year provided
    Resource -> Facade: getYearBalances(id, year)
    activate Facade
    Facade -> UseCase: getYearBalances(id, year)
    activate UseCase
    UseCase --> Facade: Result<List<MonthlyBalance>>
    deactivate UseCase
    Facade --> Resource: Result<List<MonthlyBalance>>
    deactivate Facade
    Resource --> Client: 200 OK (List<MonthlyBalance>)
end
deactivate Resource

== GET /api/{uuid}/accounts/{id} ==
Client -> Resource: GET /api/{uuid}/accounts/{id}
activate Resource
Resource -> Facade: findAccount(id)
activate Facade
Facade -> UseCase: findAccount(id)
activate UseCase
UseCase --> Facade: Result<MonetaryAccount>
deactivate UseCase
Facade --> Resource: Result<MonetaryAccount>
deactivate Facade
Resource -> Facade: listTransactions()
activate Facade
Facade --> Resource: Result<List<MonetaryTransaction>>
deactivate Facade
Resource --> Client: 200 OK (Account)
deactivate Resource

== POST /api/{uuid}/accounts ==
Client -> Resource: POST /api/{uuid}/accounts (AccountRequest)
activate Resource
Resource -> Facade: createAccount(AccountCommand)
activate Facade
Facade -> UseCase: createAccount(AccountCommand)
activate UseCase
UseCase --> Facade: Result<MonetaryAccount>
deactivate UseCase
Facade --> Resource: Result<MonetaryAccount>
deactivate Facade
Resource --> Client: 201 Created (Account)
deactivate Resource

== PATCH /api/{uuid}/accounts/{id} ==
Client -> Resource: PATCH /api/{uuid}/accounts/{id} (AccountRequest)
activate Resource
Resource -> Facade: updateAccount(id, AccountCommand)
activate Facade
Facade -> UseCase: updateAccount(id, AccountCommand)
activate UseCase
UseCase --> Facade: Result<MonetaryAccount>
deactivate UseCase
Facade --> Resource: Result<MonetaryAccount>
deactivate Facade
Resource --> Client: 200 OK (Account)
deactivate Resource

== DELETE /api/{uuid}/accounts/{id} ==
Client -> Resource: DELETE /api/{uuid}/accounts/{id}
activate Resource
Resource -> Facade: deleteAccount(id)
activate Facade
Facade -> UseCase: deleteAccount(id)
activate UseCase
UseCase --> Facade: Result<Void>
deactivate UseCase
Facade --> Resource: Result<Void>
deactivate Facade
Resource --> Client: 204 No Content
deactivate Resource
@enduml
