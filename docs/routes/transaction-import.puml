@startuml
title Transaction Import Routes

actor Client
participant "StatementImportResource" as Resource
participant "StatementImportUseCase" as UseCase

== POST /api/{uuid}/accounts/transactions/import/preview ==
Client -> Resource: POST /api/{uuid}/accounts/transactions/import/preview (MultipartFile)
activate Resource
Resource -> UseCase: preview(bytes, password, accountId)
activate UseCase
UseCase --> Resource: Result<ImportPreviewOutcome>
deactivate UseCase
Resource --> Client: 200 OK (ImportPreviewResponse or BankStatementPreviewResponse)
deactivate Resource

== POST /api/{uuid}/accounts/transactions/import/confirm ==
Client -> Resource: POST /api/{uuid}/accounts/transactions/import/confirm (StatementConfirmRequest)
activate Resource

alt type = CREDIT_CARD_INVOICE
  Resource -> UseCase: confirm(ImportConfirmCommand)
  activate UseCase
  UseCase --> Resource: Result<ImportResult>
  deactivate UseCase
else type = BANK_STATEMENT
  Resource -> UseCase: confirmStatement(BankStatementConfirmCommand)
  activate UseCase
  UseCase --> Resource: Result<ImportResult>
  deactivate UseCase
end

Resource --> Client: 200 OK (ImportConfirmResponse)
deactivate Resource
@enduml
