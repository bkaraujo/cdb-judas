flowchart LR
%% CDB Finance — Backend: diagrama de pacotes (placement de classes).
%% Cada caixa diz o que MORA no pacote; setas = dependências permitidas.
%% ArchUnit proíbe: Resource→Repository; _1_application→_2_infrastructure (por fNNN);
%% core→feature; fatia fNNN↔fNNN irmã, em qualquer direção (regra
%% feature_slices_must_not_depend_on_sibling_slices). Só duas exceções nomeadas: alvo f000
%% (kernel) e origem f999 (composition root). Cross-slice de verdade é sempre evento
%% (f000._0_domain.event, efeito sem retorno), f000.InternalApi (HTTP interno contra o endpoint
%% público da fatia dona, leitura síncrona com retorno), ou adapter em
%% f999._2_infrastructure.adapter (porta declarada pelo consumidor, provedor do outro lado).
%% Exceção temporária (desde a fase 2 de .claude/plan.md, ver javadoc de isDissolvedContextRemnant
%% em ArchitectureTest): acesso direto a subpacotes _0_domain.model/repository/event e
%% _1_application.command/service/usecase/event — organização que as classes de
%% br-context-monetary/br-context-people já tinham antes da dissolução dos contextos (fase 2),
%% preservada dentro de fNNN.

    subgraph feature["br.cdb.feature.fNNN  (f000–f006, f009, f999)"]
        F2["_2_infrastructure<br>*Resource (borda HTTP — só tradução de formato)<br>*Request / *Response (DTOs da API)<br>*JDBCRepository (adaptador da porta _0, feature nativa)<br>FNNNModule (CDI)"]
        F1["_1_application<br>*Service · *UseCase (orquestra tudo)<br>commands · @MessageListener (best-effort)<br>usecase/service — engines ex-contexto, Registry-wired<br>(f002 accounts/balance, f003 cards, f006 transactions,<br>f000 cost center/person)"]
        F0["_0_domain<br>modelos/overlays · *Repository (PORTAS)<br>eventos de domínio da feature<br>model/repository/event — remanescente ex-contexto"]
    end

    subgraph base["br.cdb.feature.f000  (fatia-base)"]
        BASE["stream/SSE · deletion · auth · UserGuards<br>costcenter · version · closing · InternalApi<br>toda fNNN pode depender dela; ela de nenhuma"]
    end

    subgraph root["br.cdb.feature.f999  (composition root)"]
        ROOT["provisionamento no startup (cria admin, dispara seed)<br>único dono do dispatch SSE (Account/Tag/CategoryStreamListener)<br>_2_infrastructure.adapter — só adapter porta→provedor ativo hoje:<br>DeletionQueueAdapter (f002.DeletionQueue → f999.DeletionQueueService)<br>pode depender de todas"]
    end

    subgraph core["br.cdb.core"]
        CORE["filtros: token rotativo (+ efêmero p/ InternalApi) + OwnershipFilter<br>log de requisição + MDC<br>config HTTP/OpenAPI · persistência JSON<br>ContextBridge (publica *JDBCRepository das engines no Registry)"]
    end

    subgraph infra["br.cdb.infra"]
        INF["*JDBCRepository das engines ex-contexto (Account/Balance/<br>CreditCard/Transaction/Person/User/CostCenter)<br>— adaptadores de feature nativa ficam em fNNN/_2, não aqui<br>migrações one-shot · adaptador MessageBus"]
    end

    subgraph commons["br.commons"]
        COM["Result · Registry · MessageBus · Logger<br>jdbc pool/primitives · json Storage<br>PdfBoxTextExtractor · YAML · platform"]
    end

    DB[("H2 — dev: file ./database · teste: in-memory<br>schema canônico: docs/db-features.mermaid")]

    F2 --> F1
    F1 --> F0
    F2 -.->|"implementa a porta _0"| F0
    F1 --> BASE
    F2 --> BASE
    F2 --> CORE
    F0 -.->|"evento / InternalApi"| BASE
    ROOT --> feature
    ROOT -.->|"adapter implementa porta declarada pelo consumidor"| F0
    INF -.->|"implementa as portas das engines"| F0
    INF --> DB
    INF --> COM
    CORE --> COM
    feature --> COM
