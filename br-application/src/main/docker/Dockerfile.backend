# syntax=docker/dockerfile:1

# ============================================================================
# Frontend stage — builda a SPA TS/Vite (frontend/dist).
# O pom de br-application copia frontend/dist para META-INF/resources e chama
# `npm ci`/`npm run build` no generate-resources, mas a imagem do Maven não tem
# Node. Por isso o bundle sai aqui e entra pronto na stage do Maven, que roda com
# -Dexec.skip=true. Mesma receita de Dockerfile.frontend (nginx), duplicada de
# propósito: as duas imagens são construídas de forma independente.
# ============================================================================
FROM node:22-alpine AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ============================================================================
# Build stage — compila e empacota a fast-jar do Quarkus.
# Base com Maven 3.9 + Temurin 25, exigidos pelo maven-enforcer-plugin do pom.
# ============================================================================
FROM maven:3.9-eclipse-temurin-25 AS builder
WORKDIR /app

# .mvn/jvm.config traz os --add-exports/--add-opens que o ErrorProne exige para
# acessar internals do javac. Sem ele a compilação falha com "An unknown
# compilation problem occurred".
COPY .mvn ./.mvn
COPY pom.xml .

# Reactor multi-módulo (pom.xml raiz é só o agregador — packaging=pom, <modules>
# aponta pra estes 3 diretórios). br-application depende de br-parent/br-commons;
# ambos precisam estar no contexto pro `mvn package` resolver via reactor (sem
# precisar de `mvn install` prévio). Os antigos br-context-people/br-context-monetary
# foram dissolvidos na fase 2 e não existem mais — copiá-los quebrava o build aqui.
# frontend/dist vem pronto da stage anterior porque o pom copia esse diretório pro
# classpath (META-INF/resources) — é o que faz o Quarkus servir a SPA como estático.
COPY br-parent ./br-parent
COPY br-commons ./br-commons
COPY br-application ./br-application
COPY --from=frontend /src/dist ./frontend/dist

# `dependency:go-offline` (usado antes para cachear as dependências numa camada
# separada de pom.xml, antes desta linha) falhava com "version is missing" para
# dependências geridas só pelo BOM do Quarkus (rest-assured, junit-jupiter-params
# etc.) — gap pré-existente (já estava assim antes da migração), só descoberto
# agora ao tentar validar a imagem de fato. Unificado num único passo (perde o
# cache de dependências entre builds só de código) para não depender desse goal.
# NOTA: build de imagem não verificado fim-a-fim neste ambiente — o `mvn package`
# aqui dentro do container também não resolveu o BOM (mesmas coordenadas que
# `mvn verify` resolve sem problema fora do container), o que aponta para uma
# restrição de rede do sandbox de build e não para o Dockerfile em si; validar
# num Docker com rede irrestrita antes de depender disto em CI/produção.
# Compila o reactor inteiro; a fast-jar de saída fica em
# br-application/target/quarkus-app/ (app/ + lib/ + quarkus/ + quarkus-run.jar).
# Testes ficam por conta do CI; a imagem foca no runtime.
# -Dexec.skip=true: o bundle da SPA já veio da stage `frontend`; sem isto o Maven
# tentaria rodar `npm`, que não existe nesta imagem.
RUN mvn -B package -DskipTests -Dexec.skip=true

# ============================================================================
# Runtime stage — apenas o JRE e a fast-jar. Imagem final enxuta.
# ============================================================================
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

# Versão atual do sistema (pom <version>). Sobrescrevível pelo build do compose.
ARG APP_VERSION=0.1.0
LABEL org.opencontainers.image.title="cdb-judas-backend" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.vendor="br.cdb"

# Diretório de persistência JSON. Liga storage.json.path (@ConfigMapping) a um
# caminho de container que o compose monta a partir do ./data do host. mkdir
# garante execução mesmo sem volume.
ENV STORAGE_JSON_PATH=/data
RUN mkdir -p /data

# fast-jar preserva a estrutura de diretórios (app/ lib/ quarkus/ + quarkus-run.jar);
# não é um único jar copiável como o repackaged do Spring Boot.
COPY --from=builder /app/br-application/target/quarkus-app/ ./

# Configuração da aplicação (cdb.*): CoreModule lê `application.yaml` do DIRETÓRIO DE
# TRABALHO (não do classpath), caminho sobrescrevível por -Dcdb.application.yaml. Sem
# este arquivo em /app o boot morre em `Missing [cdb.datasource] in application.yaml`
# (Logger.fatal → exit 99). Vem do contexto de build, não da stage anterior.
COPY application.yaml ./application.yaml

EXPOSE 8080

# --enable-preview é obrigatório: o código é compilado com preview features do
# Java 25, logo a JVM de runtime precisa habilitá-las ou a inicialização falha.
ENTRYPOINT ["java", "--enable-preview", "-jar", "quarkus-run.jar"]
