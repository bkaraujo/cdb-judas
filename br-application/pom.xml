<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.cdb</groupId>
        <artifactId>parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../br-parent</relativePath>
    </parent>

    <artifactId>application</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!-- default de -Dexec.skip: mesma flag que pulava o bundle no exec-maven-plugin
             (ver README.md/CLAUDE.md/.githooks/pre-commit) — mantida ao trocar pro
             frontend-maven-plugin, que não a conhece nativamente. -->
        <exec.skip>false</exec.skip>
    </properties>

    <dependencies>
        <dependency><groupId>br.cdb</groupId><artifactId>commons</artifactId><version>${project.version}</version></dependency>

        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-arc</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest-jackson</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-hibernate-validator</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-smallrye-openapi</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-smallrye-health</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-elytron-security-common</artifactId></dependency>
        <!-- quarkus-scheduler declara o bridge SLF4J do JBoss direto (por causa do cron-utils):
             exclusão aqui, no ponto de declaração — o resto vem por quarkus-core, excluído no
             dependencyManagement de br-parent (ver comentário lá). -->
        <dependency>
            <groupId>io.quarkus</groupId><artifactId>quarkus-scheduler</artifactId>
            <exclusions>
                <exclusion><groupId>org.jboss.slf4j</groupId><artifactId>slf4j-jboss-logmanager</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>

        <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- SPA TS/Vite: frontend/dist sai do `npm run build` amarrado ao generate-resources
                 (plugin exec abaixo) e é copiada verbatim para o classpath. Quarkus serve
                 conteúdo estático de META-INF/resources automaticamente (convenção servlet).
                 Ancorado em maven.multiModuleProjectDirectory (raiz do repo) porque frontend/
                 vive lá, não dentro deste módulo — um <directory>frontend/dist</directory>
                 relativo resolveria contra o basedir deste pom e não acharia nada. -->
            <resource>
                <directory>${maven.multiModuleProjectDirectory}/frontend/dist</directory>
                <targetPath>META-INF/resources</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- CoreModule lê o YAML pelo caminho em cdb.application.yaml (default: ./application.yaml,
                 relativo ao CWD). O fork do surefire roda em br-application/, onde não existe o arquivo
                 da raiz do repo — e o de dev aponta pro H2 em arquivo. Aponta pro YAML de teste. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <cdb.application.yaml>${project.build.testOutputDirectory}/application.test.yaml</cdb.application.yaml>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Build da SPA antes do process-resources, que é a fase que copia frontend/dist
                 para o classpath. Node/npm vêm baixados e fixados pelo próprio plugin (instalados
                 em frontend/node, fora do PATH do sistema) — não depende de nvm nem de qual node
                 estiver ativo no shell que invoca o mvn (era o exec-maven-plugin com <executable>npm</executable>
                 antes, resolvido via PATH). `-Dexec.skip=true` pula as três execuções para quem não
                 precisa do bundle — é o que o gate ArchUnit do .githooks/pre-commit faz. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}/frontend</workingDirectory>
                    <installDirectory>${maven.multiModuleProjectDirectory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>frontend-install-node-npm</id>
                        <phase>generate-resources</phase>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration>
                            <nodeVersion>v22.22.1</nodeVersion>
                            <skip>${exec.skip}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <arguments>ci</arguments>
                            <skip>${exec.skip}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-bundle</id>
                        <phase>generate-resources</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <arguments>run build</arguments>
                            <skip>${exec.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
