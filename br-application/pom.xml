<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.cdb</groupId>
        <artifactId>parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../br-parent</relativePath>
    </parent>

    <artifactId>application</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency><groupId>br.cdb</groupId><artifactId>commons</artifactId><version>${project.version}</version></dependency>

        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-arc</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest-jackson</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-hibernate-validator</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-smallrye-openapi</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-smallrye-health</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-elytron-security-common</artifactId></dependency>
        <!-- quarkus-scheduler declara o bridge SLF4J do JBoss direto (por causa do cron-utils):
             exclusão aqui, no ponto de declaração — o resto vem por quarkus-core, excluído no
             dependencyManagement de br-parent (ver comentário lá). -->
        <dependency>
            <groupId>io.quarkus</groupId><artifactId>quarkus-scheduler</artifactId>
            <exclusions>
                <exclusion><groupId>org.jboss.slf4j</groupId><artifactId>slf4j-jboss-logmanager</artifactId></exclusion>
            </exclusions>
        </dependency>

        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>

        <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- SPA vanilla (sem etapa de build): copiada verbatim para o classpath. Quarkus serve
                 conteúdo estático de META-INF/resources automaticamente (convenção servlet).
                 Ancorado em maven.multiModuleProjectDirectory (raiz do repo) porque web/ vive lá,
                 não dentro deste módulo — um <directory>web</directory> relativo resolveria contra
                 o basedir deste pom e não acharia nada. -->
            <resource>
                <directory>${maven.multiModuleProjectDirectory}/web</directory>
                <targetPath>META-INF/resources</targetPath>
                <filtering>false</filtering>
                <excludes>
                    <exclude>CLAUDE.md</exclude>
                    <exclude>package.json</exclude>
                    <exclude>package-lock.json</exclude>
                    <!-- Dependências de desenvolvimento do harness de teste (puppeteer-core &
                         cia., ~30 MB). Sem esta exclusão elas iam parar dentro da fast-jar e
                         ficavam servidas publicamente em /node_modules/**. -->
                    <exclude>node_modules/**</exclude>
                    <exclude>tools/**</exclude>
                    <exclude>test/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- CoreModule lê o YAML pelo caminho em cdb.application.yaml (default: ./application.yaml,
                 relativo ao CWD). O fork do surefire roda em br-application/, onde não existe o arquivo
                 da raiz do repo — e o de dev aponta pro H2 em arquivo. Aponta pro YAML de teste. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <cdb.application.yaml>${project.build.testOutputDirectory}/application.test.yaml</cdb.application.yaml>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Profile inativo por padrão: sem ele, o build continua idêntico ao de hoje, servindo web/
         (SPA vanilla). Ativado explicitamente (-Pfrontend-ts) builda e serve o frontend TS/Vite de
         frontend/dist no lugar. Os dois <resource> colidiriam (ambos têm index.html) se ativos ao
         mesmo tempo — por isso este entra num profile, não direto em <build><resources> acima. O
         cutover (tornar o profile default, apagar web/) é decisão separada, fora deste plano. -->
    <profiles>
        <profile>
            <id>frontend-ts</id>
            <build>
                <resources>
                    <resource>
                        <directory>${maven.multiModuleProjectDirectory}/frontend/dist</directory>
                        <targetPath>META-INF/resources</targetPath>
                        <filtering>false</filtering>
                    </resource>
                </resources>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>frontend-build</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}/frontend</workingDirectory>
                                    <executable>npm</executable>
                                    <arguments><argument>ci</argument></arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>frontend-bundle</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}/frontend</workingDirectory>
                                    <executable>npm</executable>
                                    <arguments><argument>run</argument><argument>build</argument></arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
