# Contexto de build do Docker é a RAIZ do repositório (ver docker-compose.yaml).
# Sem estas exclusões, node_modules e o alvo do Maven viajam para o daemon a cada
# build. As duas imagens rodam `npm ci` dentro da stage node, então a árvore local
# não deve nem entrar no contexto.

# Toolchain do frontend (reinstalada por `npm ci` na stage de build)
frontend/node_modules/
frontend/dist/

# Saída de build
target/
*/target/

# Banco de desenvolvimento local (H2)
database.mv.db
database.trace.db
data/

# Metadados de ferramenta
.git/
.github/
.githooks/
.idea/
.mvn/repository/
.claude/
.ignored/
